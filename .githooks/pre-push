#!/usr/bin/env bash
# Blocks a push until the format check and the linters pass.
# Enable once per clone: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
bazel run //:format-check || { echo "pre-push: formatting failed. Run 'bazel run //:format'." >&2; exit 1; }
bazel run //:lint || { echo "pre-push: lint failed." >&2; exit 1; }
